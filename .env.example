# ──────────────────────────────────────────────────────────────────
# WareFlow Auth Service — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowstock
DB_USERNAME=ashishbhardwaj
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=GENERATE_A_STRONG_BASE64_SECRET_HERE
JWT_ACCESS_EXPIRY=900          # 15 minutes (seconds)
JWT_REFRESH_EXPIRY=2592000     # 30 days (seconds)

# ── Google OAuth2 ─────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email / SMTP ──────────────────────────────────────────────────
# Local dev: use MailHog (docker-compose spins it up at localhost:1025)
# Production: use Gmail, SendGrid, SES etc.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── App ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
MAX_LOGIN_ATTEMPTS=5
SERVER_PORT=8081

# ── Cookie ────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
