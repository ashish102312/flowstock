# ==============================================================================
# Universal .gitignore
# ==============================================================================

# OS & Environment
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.iml
*.iws
*.ipr
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets and Environment Variables - NEVER COMMIT
.env
.env.*
!.env.example
*.local

# Node.js / Frontend
node_modules/
dist/
dist-ssr/
build/
.cache/
*.tsbuildinfo
coverage/
.npm/
.eslintcache
.stylelintcache

# Java / Maven / Spring Boot
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
spring-boot-maven-plugin*

# Python (in case it is used)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Docker and Infrastructure
docker-compose.yml
docker-compose.override.yml
.docker/
postgres_data/
redis_data/
.superdesign
data/
